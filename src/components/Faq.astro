---
import type { FaqItem } from "../lib/schema";

interface Props {
  items: FaqItem[];
}

const { items } = Astro.props;
---

<section class="faq" aria-labelledby="faq-heading">
  <h2 id="faq-heading">Questions people ask</h2>
  <div class="faq-list">
    {
      items.map((item) => (
        <details>
          <summary>{item.question}</summary>
          <p>{item.answer}</p>
        </details>
      ))
    }
  </div>
</section>
