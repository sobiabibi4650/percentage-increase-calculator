---
import { calculators } from "../lib/nav";
const current = Astro.url.pathname.replace(/\/$/, "") || "/";
const visible = calculators.filter((l) => l.href !== current);
---

<section class="see-also" aria-labelledby="see-also-heading">
  <h2 id="see-also-heading">More percentage calculators</h2>
  <ul class="tool-grid">
    {visible.map((l) => <li><a href={l.href}><strong>{l.label}</strong><span>{l.blurb}</span></a></li>)}
  </ul>
</section>
