---
const links = [
  { href: "/", label: "Percentage increase calculator" },
  { href: "/percent-change-calculator", label: "Percent change calculator" },
  { href: "/percentage-decrease-calculator", label: "Percentage decrease calculator" },
  { href: "/percentage-difference-calculator", label: "Percentage difference calculator" },
  { href: "/add-percentage-calculator", label: "Add a percentage" },
  { href: "/reverse-percentage-calculator", label: "Reverse a percentage" },
  { href: "/salary-increase-calculator", label: "Salary increase calculator" },
  { href: "/price-increase-calculator", label: "Price increase calculator" },
  { href: "/percentage-increase-formula", label: "Percentage increase formula" },
  { href: "/how-to-calculate-percentage-increase", label: "How to calculate it" },
  { href: "/excel-percentage-increase", label: "Excel and Google Sheets" },
  { href: "/percentage-points-vs-percentage-increase", label: "Percentage points vs increase" },
];

const current = Astro.url.pathname.replace(/\/$/, "") || "/";
const visible = links.filter((link) => link.href !== current);
---

<section class="see-also" aria-labelledby="see-also-heading">
  <h2 id="see-also-heading">Related pages</h2>
  <ul>
    {visible.map((link) => (
      <li><a href={link.href}>{link.label}</a></li>
    ))}
  </ul>
</section>
