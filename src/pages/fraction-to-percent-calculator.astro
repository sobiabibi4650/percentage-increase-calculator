---
import BaseLayout from "../layouts/BaseLayout.astro";
import ToolCalc from "../components/ToolCalc.tsx";
import Crumbs from "../components/Crumbs.astro";
import Faq from "../components/Faq.astro";
import SeeAlso from "../components/SeeAlso.astro";
import ConversionHub from "../components/ConversionHub.astro";
import type { FaqItem } from "../lib/schema";

const faqs: FaqItem[] = [
  { question: "What is 2/5 as a percent?", answer: "2 ÷ 5 = 0.4, so 2/5 is 40%." },
  { question: "What is 6/7 as a percent?", answer: "6 ÷ 7 = 0.857142…, about 85.71%." },
  { question: "What is 1/8 as a percent?", answer: "1 ÷ 8 = 0.125, so 1/8 is 12.5%." },
  { question: "What is 4 3/4 as a percent?", answer: "4 3/4 = 4.75, which is 475%." }
];
---

<BaseLayout
  title="Fraction to Percent Calculator"
  description="Convert any fraction or mixed number to a percent, like 3/5, 6/7, 1/8, or 4 3/4. See the decimal, the steps, and a chart of common fractions."
  path="/fraction-to-percent-calculator"
  faqs={faqs}
  crumb={{ name: "Fraction to percent", path: "/fraction-to-percent-calculator" }}
  webApp
>
  <Crumbs current="Fraction to percent" />
  <h1>Fraction to Percent Calculator</h1>
  <p class="lede">Type a fraction (3/5), a mixed number (4 1/4), or a decimal (0.35). The percent appears as you type.</p>
  <ToolCalc client:load tool="fraction" />

  <section>
    <h2>How to convert a fraction to a percent</h2>
    <p>Divide the top number by the bottom number, then multiply by 100. 3/5 = 0.6, and 0.6 × 100 = <strong>60%</strong>.</p>
    <p>For a mixed number, convert the fraction part and add the whole number × 100: 4 3/4 = 4.75 = 475%.</p>
  </section>
  <section>
    <h2>Fractions over 1</h2>
    <p>Improper fractions such as 5/4 or 3/2 give percents above 100% (125% and 150%).</p>
  </section>
  <section>
    <h2>Convert a decimal to a percent</h2>
    <p>Decimals work too. Multiply by 100, which is the same as moving the decimal point two places to the right: 0.35 becomes 35%, 0.075 becomes 7.5%, and 1.2 becomes 120%. Type the decimal into the box above to check.</p>
  </section>
  <section>
    <h2>Repeating decimals</h2>
    <p>Some fractions never end in decimal form. 1/3 is 0.333…, so it becomes 33.33% when rounded to two places, and 2/3 becomes 66.67%. 1/6 works out to 16.67%, and 6/7 to about 85.71%. The calculator rounds to two decimals, which is what most teachers and textbooks expect.</p>
  </section>
  <section>
    <h2>Turn a percent back into a fraction</h2>
    <p>To go the other way, write the percent over 100 and simplify. 60% is 60/100, which reduces to 3/5. 12.5% is 12.5/100, or 125/1000, which simplifies to 1/8. Knowing a few pairs by heart, such as 1/4 = 25% and 1/8 = 12.5%, makes mental math much faster.</p>
  </section>
  <section>
    <h2>Fractions that are already out of 100</h2>
    <p>When the bottom number divides evenly into 100, scale the fraction up instead of dividing. 3/20 becomes 15/100 by multiplying top and bottom by 5, so it is 15%. 7/25 becomes 28/100, or 28%. This trick is quick for test scores out of 20, 25, or 50; for scores out of other totals, try the <a href="/percentage-calculator">percentage calculator</a>.</p>
  </section>
  <section>
    <h2>Fraction to percent chart</h2>
    <div class="table-scroll"><table class="data">
      <thead><tr><th>Fraction</th><th>Decimal</th><th>Percent</th></tr></thead>
      <tbody>
        <tr><td>1/8</td><td>0.125</td><td>12.5%</td></tr>
        <tr><td>1/6</td><td>0.1667</td><td>16.6667%</td></tr>
        <tr><td>1/5</td><td>0.2</td><td>20%</td></tr>
        <tr><td>1/4</td><td>0.25</td><td>25%</td></tr>
        <tr><td>1/3</td><td>0.3333</td><td>33.3333%</td></tr>
        <tr><td>3/8</td><td>0.375</td><td>37.5%</td></tr>
        <tr><td>2/5</td><td>0.4</td><td>40%</td></tr>
        <tr><td>1/2</td><td>0.5</td><td>50%</td></tr>
        <tr><td>3/5</td><td>0.6</td><td>60%</td></tr>
        <tr><td>5/8</td><td>0.625</td><td>62.5%</td></tr>
        <tr><td>2/3</td><td>0.6667</td><td>66.6667%</td></tr>
        <tr><td>5/7</td><td>0.7143</td><td>71.4286%</td></tr>
        <tr><td>3/4</td><td>0.75</td><td>75%</td></tr>
        <tr><td>4/5</td><td>0.8</td><td>80%</td></tr>
        <tr><td>6/7</td><td>0.8571</td><td>85.7143%</td></tr>
        <tr><td>5/4</td><td>1.25</td><td>125%</td></tr>
        <tr><td>3/2</td><td>1.5</td><td>150%</td></tr>
        <tr><td>4 1/4</td><td>4.25</td><td>425%</td></tr>
        <tr><td>4 3/4</td><td>4.75</td><td>475%</td></tr>
        <tr><td>5 1/5</td><td>5.2</td><td>520%</td></tr>
      </tbody>
    </table></div>
  </section>
  <ConversionHub kind="fractions" />
  <Faq items={faqs} />
  <SeeAlso />
</BaseLayout>
