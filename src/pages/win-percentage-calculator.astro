---
import BaseLayout from "../layouts/BaseLayout.astro";
import ToolCalc from "../components/ToolCalc.tsx";
import Crumbs from "../components/Crumbs.astro";
import Faq from "../components/Faq.astro";
import SeeAlso from "../components/SeeAlso.astro";
import ConversionHub from "../components/ConversionHub.astro";
import type { FaqItem } from "../lib/schema";

const faqs: FaqItem[] = [
  { question: "How do ties affect win percentage?", answer: "Most leagues, including the NFL, count a tie as half a win and half a loss." },
  { question: "Is win percentage the same as winning percentage?", answer: "Yes, the terms are used interchangeably." },
  { question: "What is a .500 record?", answer: "Exactly as many wins as losses, such as 41–41." }
];
---

<BaseLayout
  title="Win Percentage Calculator (Win-Loss Record)"
  description="Calculate a team's win percentage from wins, losses, and ties in the .xxx format used in MLB, NBA, and NFL standings, with ties counted as half a win."
  path="/win-percentage-calculator"
  faqs={faqs}
  crumb={{ name: "Win percentage", path: "/win-percentage-calculator" }}
  webApp
>
  <Crumbs current="Win percentage" />
  <h1>Win Percentage Calculator (Win-Loss Record)</h1>
  <p class="lede">Enter a win-loss record to get the win percentage, also called win rate. Ties count as half a win, the standard used in NFL standings.</p>
  <ToolCalc client:load tool="win" />

  <section>
    <h2>Win percentage formula</h2>
    <pre>Win % = (Wins + Ties ÷ 2) ÷ Games played</pre>
    <p>A 12–8 record: 12 ÷ 20 = <strong>.600</strong>, or 60%.</p>
  </section>
  <section>
    <h2>Why standings show .600</h2>
    <p>US sports leagues print win percentage as a three-digit decimal with no leading zero. A perfect record is 1.000.</p>
  </section>
  <section>
    <h2>How to calculate win percentage</h2>
    <p>Add the wins and losses (and ties, if any) to get the games played. Divide the wins by that total. A basketball team at 27–13 has played 40 games, so 27 ÷ 40 = .675, a 67.5% win rate. With ties, add half of each tie to the wins before dividing.</p>
  </section>
  <section>
    <h2>How standings use the number</h2>
    <p>League tables sort teams by this figure because it treats teams fairly even when they have played a different number of games. A club that is 30–20 (.600) is ahead of one that is 31–22 (.585), even though the second club has more wins.</p>
    <p>Early in a season the decimal swings a lot. One extra victory moves a 3–2 team from .600 to .667, while the same result barely moves a 60–40 team. Read early-season records with that in mind.</p>
  </section>
  <section>
    <h2>Games behind and magic numbers</h2>
    <p>Standings often show “games behind” next to each record. It is the average of the gap in wins and the gap in losses between two teams. If the leader is 50–30 and your team is 46–34, the gap is (4 + 4) ÷ 2 = 4 games. That measure and the decimal tell the same story from different angles.</p>
  </section>
  <section>
    <h2>Ties in different sports</h2>
    <ul class="plain-list"><li><strong>NFL:</strong> a tie counts as half a win and half a loss, which is what this calculator does.</li><li><strong>NHL:</strong> points, not this decimal, decide standings, so overtime losses are tracked separately.</li><li><strong>Soccer leagues:</strong> standings use points (3 for a win, 1 for a draw). The decimal is still useful for comparing form.</li><li><strong>Youth and rec leagues:</strong> check the league rules. Some ignore ties entirely; enter 0 ties to match that.</li></ul>
  </section>

  <Faq items={faqs} />
  <SeeAlso />
</BaseLayout>
