---
import BaseLayout from "../layouts/BaseLayout.astro";
import Calculator from "../components/Calculator.tsx";
import Crumbs from "../components/Crumbs.astro";
import Faq from "../components/Faq.astro";
import SeeAlso from "../components/SeeAlso.astro";
import type { FaqItem } from "../lib/schema";

const faqs: FaqItem[] = [
  {
    question: "How do you calculate a percentage decrease?",
    answer:
      "Subtract the new, smaller value from the original, divide by the original, and multiply by 100. You can also run the increase formula and read a negative result as a decrease. From 80 to 60 is a 25% decrease.",
  },
  {
    question: "Is a 50% decrease the reverse of a 50% increase?",
    answer:
      "No. A 50% increase takes 80 to 120. A 50% decrease takes 80 to 40. To undo a 25% decrease you need a 33.3333% increase, not another 25% move.",
  },
  {
    question: "What is a 100% decrease?",
    answer:
      "The new value is 0. Anything past that is more than a total loss of the original amount, which shows up as a percent below −100% when the new value is negative.",
  },
  {
    question: "Why does the page say decrease instead of only showing a minus?",
    answer:
      "The signed percent is still there, and the word decrease is printed with it. Color is not the only cue.",
  },
];
---

<BaseLayout
  title="Percentage Decrease Calculator"
  description="See how far a number fell, as a percentage of where it started. A drop is labeled as a decrease, using the same formula as a percentage increase."
  path="/percentage-decrease-calculator"
  faqs={faqs}
  crumb={{ name: "Percentage decrease", path: "/percentage-decrease-calculator" }}
  webApp
>
  <Crumbs current="Percentage decrease" />
  <h1>Percentage Decrease Calculator</h1>
  <p class="lede">Put the higher starting number first. A fall is labeled decrease, not left as a bare minus sign.</p>
  <Calculator client:load initialMode="find" initialFrom="80" initialTo="60" />

  <section>
    <h2>Same formula, downward result</h2>
    <p>
      A decrease is not a separate kind of math. It is a percent change that came out negative. Take a jacket marked down from $80 to $60. The price fell by $20. Divide 20 by the original 80 and you get 0.25, so the markdown is 25%.
    </p>
    <p>
      People sometimes divide by the new price instead. That mistake turns this sale into 20 / 60, or about 33%, which overstates the discount. The baseline for a decrease is the price before the cut, just as the baseline for an increase is the price before the hike.
    </p>
  </section>

  <section>
    <h2>Watch the baseline when you reverse it</h2>
    <p>
      After a 25% decrease, $80 is $60. Putting 25% back onto $60 only returns $75, not $80. The original is 60 / (1 − 0.25) = 80. Use Reverse mode when you know the later number and the percent, and you need the earlier one.
    </p>
    <p>
      A starting value of 0 still cannot show a percentage decrease. There is nothing to fall from, so the result stays undefined.
    </p>
  </section>

  <Faq items={faqs} />
  <SeeAlso />
</BaseLayout>
