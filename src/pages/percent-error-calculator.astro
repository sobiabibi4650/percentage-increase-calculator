---
import BaseLayout from "../layouts/BaseLayout.astro";
import ToolCalc from "../components/ToolCalc.tsx";
import Crumbs from "../components/Crumbs.astro";
import Faq from "../components/Faq.astro";
import SeeAlso from "../components/SeeAlso.astro";
import ConversionHub from "../components/ConversionHub.astro";
import type { FaqItem } from "../lib/schema";

const faqs: FaqItem[] = [
  { question: "Can percent error be negative?", answer: "Signed percent error can be. The standard formula uses absolute value, so the result is positive." },
  { question: "What is an acceptable percent error?", answer: "In many school labs under 5% is considered good, but the threshold depends on the experiment." },
  { question: "Why can't the actual value be zero?", answer: "The formula divides by the actual value, and division by zero is undefined." }
];
---

<BaseLayout
  title="Percent Error Calculator and Formula"
  description="Find the percent error between a measured and an accepted value, with absolute and signed error and every step shown. Built for lab reports."
  path="/percent-error-calculator"
  faqs={faqs}
  crumb={{ name: "Percent error", path: "/percent-error-calculator" }}
  webApp
>
  <Crumbs current="Percent error" />
  <h1>Percent Error Calculator and Formula</h1>
  <p class="lede">Enter your measured (experimental) value and the accepted (theoretical) value.</p>
  <ToolCalc client:load tool="error" />

  <section>
    <h2>Percent error formula</h2>
    <pre>Percent error = |Measured − Actual| ÷ |Actual| × 100</pre>
    <p>This percent error equation compares what you measured with the accepted, true value. The vertical bars mean absolute value, so the answer is always positive.</p>
    <p>If you measured gravity as 9.6 m/s² and the accepted value is 9.81, the error is |9.6 − 9.81| = 0.21, and 0.21 ÷ 9.81 × 100 = <strong>2.14%</strong>.</p>
  </section>
  <section>
    <h2>Signed vs absolute percent error</h2>
    <p>Lab reports usually want the absolute value. The signed error shows direction: negative means your measurement came in low.</p>
  </section>
  <section>
    <h2>Percent error vs percent difference</h2>
    <p>Percent error compares to a known true value. When neither value is “correct”, use the <a href="/percentage-difference-calculator">percentage difference calculator</a>.</p>
  </section>
  <section>
    <h2>How to calculate percent error</h2>
    <ol class="steps"><li>Subtract the actual value from your measured value.</li><li>Drop the minus sign, if there is one (take the absolute value).</li><li>Divide by the actual value.</li><li>Multiply by 100 to turn the decimal into a percentage.</li></ol>    <p>Example: you measure a 250 mL flask as holding 245 mL. |245 − 250| = 5, 5 ÷ 250 = 0.02, and 0.02 × 100 = 2% error.</p>
  </section>
  <section>
    <h2>A worked lab example</h2>
    <p>Suppose your class measures the boiling point of water as 98.6 °C at sea level, where the accepted value is 100 °C. The absolute difference is 1.4 °C. Divide by 100 and multiply by 100 to get <strong>1.4%</strong>. Because the measured value came in low, the signed version is −1.4%.</p>
    <p>In a lab report, state both the number and a likely cause, such as a thermometer that was not fully calibrated or a reading taken before the water reached a full boil.</p>
  </section>
  <section>
    <h2>Accuracy versus precision</h2>
    <p>This figure measures accuracy: how close a result is to the true value. Precision is different. It describes how close repeated measurements are to each other. Five readings of 9.60, 9.61, 9.59, 9.60, and 9.61 m/s² are very precise, yet each one is still about 2% away from the accepted 9.81, so they are not accurate.</p>
  </section>
  <section>
    <h2>Common reasons for a large error</h2>
    <ul class="plain-list"><li>Reading a scale from an angle (parallax).</li><li>Rounding intermediate values too early.</li><li>Using the wrong units, such as grams where kilograms were expected.</li><li>Equipment that drifts with temperature.</li><li>Comparing against an accepted value for different conditions, like a different altitude.</li></ul>
  </section>

  <Faq items={faqs} />
  <SeeAlso />
</BaseLayout>
