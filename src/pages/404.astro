---
import BaseLayout from "../layouts/BaseLayout.astro";
import SeeAlso from "../components/SeeAlso.astro";
---

<BaseLayout
  title="Page not found"
  description="That page is not on the percentage increase calculator site. Use the home calculator or one of the related tools."
  path="/404"
  noindex
>
  <h1>Page not found</h1>
  <p class="lede">That address is not on this site. Pick a calculator below, or start from the home page.</p>
  <p><a class="button" href="/">Go to the calculator</a></p>
  <SeeAlso />
</BaseLayout>
